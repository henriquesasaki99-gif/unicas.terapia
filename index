const MONTH_NAMES=['Janeiro','Fevereiro','Março','Abril','Maio','Junho','Julho','Agosto','Setembro','Outubro','Novembro','Dezembro'];

function clampDay(year,monthIndex,day){
 const last=new Date(year,monthIndex+1,0).getDate();
 return Math.min(Math.max(1,Number(day)||1),last);
}
function dateISO(year,monthIndex,day){
 const d=clampDay(year,monthIndex,day);
 return `${year}-${String(monthIndex+1).padStart(2,'0')}-${String(d).padStart(2,'0')}`;
}
function todayISO(){
 const d=new Date();
 return `${d.getFullYear()}-${String(d.getMonth()+1).padStart(2,'0')}-${String(d.getDate()).padStart(2,'0')}`;
}
function automaticInstallmentStatus(dueDate,storedStatus){
 if(storedStatus==='Pago')return 'Pago';
 const today=todayISO();
 const dueMonth=dueDate.slice(0,7),currentMonth=today.slice(0,7);
 if(dueMonth>currentMonth)return 'A vencer';
 if(dueDate<today)return 'Vencido';
 return 'Pendente';
}
function studentInstallmentStatus(dueDate,storedStatus){
 const st=automaticInstallmentStatus(dueDate,storedStatus);
 return (st==='Pendente'||st==='A vencer')?'Em dia':st;
}
function courseDisplayStatus(client,course){
 const inst=buildInstallmentsForCourse(client,course);
 if(inst.some(p=>p.status==='Vencido'))return 'Vencido';
 if(inst.length&&inst.every(p=>p.status==='Pago'))return 'Pago';
 return 'Em dia';
}
function buildInstallmentsForCourse(client,course){
 const start=(client.createdAt||new Date().toISOString().slice(0,10)).split('-');
 let year=Number(start[0])||new Date().getFullYear();
 let month=(Number(start[1])||1)-1;
 const dueDay=Number(course.dueDay)||1;
 const count=Math.max(1,Number(course.installments)||1);
 const total=Number(course.value)||0;
 const per=Number(course.installmentValue)||(count?total/count:total);
 const stored=Array.isArray(course.installmentStatuses)?course.installmentStatuses:[];
 const arr=[];
 for(let i=0;i<count;i++){
   const dt=new Date(year,month+i,1);
   const yy=dt.getFullYear(),mm=dt.getMonth();
   const dueDate=dateISO(yy,mm,dueDay);
   const storedStatus=stored[i]==='Pago'?'Pago':'';
   arr.push({
     installment:i+1,totalInstallments:count,year:yy,month:mm,dueDate,value:per,
     storedStatus,
     status:automaticInstallmentStatus(dueDate,storedStatus)
   });
 }
 return arr;
}
