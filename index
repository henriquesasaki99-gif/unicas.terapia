<script>
const STUDENT_KEY='unica_gestao_v4_students';
const ADMIN_KEY='unica_gestao_v4_admin';
const OLD_KEY='unica_gestao_v1';
const COURSE_CATALOG_KEY='unica_gestao_v5_course_catalog';
const SCHEDULE_CATALOG_KEY='unica_gestao_v5_schedule_catalog';

const LEGACY_V3_STUDENT_KEY='unica_gestao_v3_students';
const LEGACY_V2_STUDENT_KEY='unica_gestao_v2_students';
const LEGACY_V3_ADMIN_KEY='unica_gestao_v3_admin';
const LEGACY_V2_ADMIN_KEY='unica_gestao_v2_admin';
let clients=[];
let admin=null;
let currentStudentId=null;
let lastCredential=null;

let courseCatalog=[];
let scheduleCatalog=[];

const DEFAULT_COURSES=[
 {id:'curso_nat',name:'Naturopatia',durationMonths:12,defaultHours:0,price:0,active:true},
 {id:'curso_mass',name:'Massoterapia',durationMonths:12,defaultHours:0,price:0,active:true},
 {id:'curso_eso',name:'Técnicas Esotéricas',durationMonths:12,defaultHours:0,price:0,active:true},
 {id:'curso_est',name:'Estética, Saúde, Beleza e Bem-estar',durationMonths:12,defaultHours:0,price:0,active:true}
];
const DEFAULT_SCHEDULES=[
 {id:'hor_manha',name:'Manhã',time:'09h - 12h',active:true},
 {id:'hor_tarde',name:'Tarde',time:'14h - 17h',active:true},
 {id:'hor_noite',name:'Noite',time:'19h - 22h',active:true},
 {id:'hor_sabado',name:'Sábado',time:'Dia inteiro',active:true}
];

function loadCatalogs(){
 try{courseCatalog=JSON.parse(localStorage.getItem(COURSE_CATALOG_KEY)||'null')||DEFAULT_COURSES.map(x=>({...x}));}
 catch(e){courseCatalog=DEFAULT_COURSES.map(x=>({...x}));}
 try{scheduleCatalog=JSON.parse(localStorage.getItem(SCHEDULE_CATALOG_KEY)||'null')||DEFAULT_SCHEDULES.map(x=>({...x}));}
 catch(e){scheduleCatalog=DEFAULT_SCHEDULES.map(x=>({...x}));}
 saveCatalogs();
}
function saveCatalogs(){
 localStorage.setItem(COURSE_CATALOG_KEY,JSON.stringify(courseCatalog));
 localStorage.setItem(SCHEDULE_CATALOG_KEY,JSON.stringify(scheduleCatalog));
}
function activeCourses(){return courseCatalog.filter(x=>x.active!==false)}
function activeSchedules(){return scheduleCatalog.filter(x=>x.active!==false)}
function courseOptions(selected=''){
 return `<option value="">Selecione o curso</option>`+activeCourses().map(x=>`<option value="${esc(x.name)}" ${x.name===selected?'selected':''}>${esc(x.name)}${x.durationMonths?` • ${x.durationMonths} meses`:''}</option>`).join('');
}
function scheduleOptions(selected=''){
 return `<option value="">Selecione o horário</option>`+activeSchedules().map(x=>`<option value="${esc(x.name)}" ${x.name===selected?'selected':''}>${esc(x.name)} • ${esc(x.time)}</option>`).join('');
}
function brl(v){
 return Number(v||0).toLocaleString('pt-BR',{style:'currency',currency:'BRL'});
}
function paymentMethodOptions(selected=''){
 const opts=['Pix','Dinheiro','Cartão de crédito','Cartão de débito','Boleto','Transferência'];
 return '<option value="">Selecione</option>'+opts.map(x=>`<option ${x===selected?'selected':''}>${x}</option>`).join('');
}
function paymentTypeOptions(selected=''){
 const opts=['À vista','Parcelado no cartão de crédito','Parcelado direto com a empresa'];
 return '<option value="">Selecione</option>'+opts.map(x=>`<option ${x===selected?'selected':''}>${x}</option>`).join('');
}
function recalcInstallment(row){
 const value=Number(row.querySelector('.c-value')?.value)||0;
 const count=Math.max(1,Number(row.querySelector('.c-installments')?.value)||1);
 const out=row.querySelector('.c-installment-value');
 if(out)out.value=(value/count).toFixed(2);
}
function syncPaymentType(row){
 const type=row.querySelector('.c-payment-type')?.value||'';
 const method=row.querySelector('.c-payment-method');
 const inst=row.querySelector('.c-installments');
 if(type==='Parcelado no cartão de crédito'){
   if(method)method.value='Cartão de crédito';
   if(inst && Number(inst.value)<2)inst.value=2;
 }else if(type==='À vista'){
   if(inst)inst.value=1;
 }else if(type==='Parcelado direto com a empresa'){
   if(inst && Number(inst.value)<2)inst.value=2;
 }
 recalcInstallment(row);
}
function getScheduleTime(name=''){
 return scheduleCatalog.find(x=>x.name===name)?.time||'';
}


function normalizeText(v=''){return v.normalize('NFD').replace(/[\u0300-\u036f]/g,'')}
function normalizeCPF(v=''){return String(v).replace(/\D/g,'')}
function generatedPassword(fullName=''){
 const parts=normalizeText(fullName.trim()).split(/\s+/).filter(Boolean);
 if(parts.length===0)return '';
 const first=parts[0].toLowerCase();
 const last=parts[parts.length-1].toLowerCase();
 return last.charAt(0).toUpperCase()+last.slice(1)+first;
}
function ensureCredentials(c){
 if(!c.portalLogin)c.portalLogin=normalizeCPF(c.cpf||'');
 if(!c.portalPassword)c.portalPassword=generatedPassword(c.name||'');
 (c.courses||[]).forEach(x=>{
   if(!x.dueDay){
     if(x.paymentDate){
       const parts=String(x.paymentDate).split('-');
       x.dueDay=Number(parts[2])||1;
     }else x.dueDay=1;
   }
   const count=Math.max(1,Number(x.installments)||1);
   if(!Array.isArray(x.installmentStatuses)){
     const wasPaid=x.paymentStatus==='Pago';
     x.installmentStatuses=Array(count).fill(wasPaid?'Pago':'');
   }else{
     x.installmentStatuses=x.installmentStatuses.map(st=>st==='Pago'?'Pago':'');
     while(x.installmentStatuses.length<count)x.installmentStatuses.push('');
     x.installmentStatuses=x.installmentStatuses.slice(0,count);
   }
   x.paymentStatus=x.installmentStatuses.length&&x.installmentStatuses.every(st=>st==='Pago')?'Pago':'Em andamento';
 });
 return c;
}
function loginKey(v=''){
 const raw=String(v||'').trim();
 const digits=raw.replace(/\D/g,'');
 if(digits.length===11 && /^[\d.\-\/\s]+$/.test(raw))return digits;
 return normalizeText(raw).toLowerCase();
}
function loadData(){
 admin=JSON.parse(localStorage.getItem(ADMIN_KEY)||'null');
 if(!admin){
   const legacyV3Admin=JSON.parse(localStorage.getItem(LEGACY_V3_ADMIN_KEY)||'null');
   const legacyAdmin=JSON.parse(localStorage.getItem(LEGACY_V2_ADMIN_KEY)||'null');
   admin=legacyV3Admin||legacyAdmin||{name:'Administrador',email:'',user:'admin',password:'admin',temporary:true,createdAt:new Date().toISOString()};
   localStorage.setItem(ADMIN_KEY,JSON.stringify(admin));
 }
 const current=JSON.parse(localStorage.getItem(STUDENT_KEY)||'null');
 if(Array.isArray(current)){
   clients=current.map(ensureCredentials);
   localStorage.setItem(STUDENT_KEY,JSON.stringify(clients));
 }
 else{
   const legacyV3=JSON.parse(localStorage.getItem(LEGACY_V3_STUDENT_KEY)||'null');
   const legacyV2=JSON.parse(localStorage.getItem(LEGACY_V2_STUDENT_KEY)||'null');
   const old=JSON.parse(localStorage.getItem(OLD_KEY)||'[]');
   clients=(Array.isArray(legacyV3)?legacyV3:(Array.isArray(legacyV2)?legacyV2:(Array.isArray(old)?old:[]))).map(ensureCredentials);
   localStorage.setItem(STUDENT_KEY,JSON.stringify(clients));
 }
}
function persistStudents(){
 localStorage.setItem(STUDENT_KEY,JSON.stringify(clients));
 return true;
}
function persistAdmin(){localStorage.setItem(ADMIN_KEY,JSON.stringify(admin))}
function init(){
 loadData();
 loadCatalogs();
 document.querySelectorAll('.nav button').forEach(b=>b.addEventListener('click',()=>showPage(b.dataset.page)));
 firstSetup.classList.add('hidden');
 loginArea.classList.remove('hidden');
 adminUser.value=admin?.user||'admin';
 adminPass.value=admin?.temporary?'admin':'';
}
function createAdmin(){
 const n=setupName.value.trim(),e=setupEmail.value.trim(),u=setupUser.value.trim(),p=setupPass.value;
 if(!n||!u||!p){setupError.textContent='Preencha nome, usuário e senha.';return}
 admin={name:n,email:e,user:u,password:p,createdAt:new Date().toISOString()};
 persistAdmin();setupError.textContent='';enterAdmin();
}
function setLoginMode(mode){
 const isAdmin=mode==='admin';
 tabAdmin.classList.toggle('active',isAdmin);tabStudent.classList.toggle('active',!isAdmin);
 adminLogin.classList.toggle('hidden',!isAdmin);studentLogin.classList.toggle('hidden',isAdmin);
 adminLoginError.textContent='';studentLoginError.textContent='';
}
function loginAdmin(){
 if(!admin){return}
 if(adminUser.value.trim()===admin.user && adminPass.value===admin.password){adminLoginError.textContent='';enterAdmin()}
 else adminLoginError.textContent='Usuário ou senha incorretos.';
}
function loginStudent(){
 const login=studentCPF.value.trim(),pass=studentPass.value;
 const c=clients.find(x=>loginKey(x.portalLogin)===loginKey(login) && x.portalPassword===pass);
 if(!login||!pass){studentLoginError.textContent='Informe login e senha.';return}
 if(!c){studentLoginError.textContent='Login ou senha incorretos.';return}
 studentLoginError.textContent='';currentStudentId=c.id;showStudentPortal(c);
}
function enterAdmin(){
 authScreen.classList.add('hidden');studentPortal.classList.add('hidden');adminApp.classList.remove('hidden');
 adminSidebarName.textContent=admin?.name||'Administrador';renderAll();showPage('dashboard');
}
function showStudentPortal(c){
 authScreen.classList.add('hidden');adminApp.classList.add('hidden');studentPortal.classList.remove('hidden');
 renderStudentPortal(c);
}
function logout(){
 currentStudentId=null;adminApp.classList.add('hidden');studentPortal.classList.add('hidden');authScreen.classList.remove('hidden');
 firstSetup.classList.add('hidden');loginArea.classList.remove('hidden');
 adminUser.value=admin?.user||'';adminPass.value='';studentCPF.value='';studentPass.value='';
}
const pageMeta={
 dashboard:['Dashboard','Visão geral do controle de alunos, cursos e pagamentos'],
 clientes:['Alunos','Cadastros e Portais do Aluno'],
 cursos:['Cursos e Horários','Grade de cursos, horários disponíveis e vínculos dos alunos'],
 pagamentos:['Pagamentos','Datas e status de pagamento dos cursos'],
 relatorios:['Relatórios','Exportações para acompanhamento administrativo'],
 usuarios:['Usuários','Administrador e acessos individuais dos alunos'],
 dados:['Dados & Backup','Backup, importação e manutenção da base local']
};
function showPage(id){
 document.querySelectorAll('#adminApp .page').forEach(p=>p.classList.remove('active'));
 document.getElementById(id).classList.add('active');
 document.querySelectorAll('.nav button').forEach(b=>b.classList.toggle('active',b.dataset.page===id));
 pageTitle.textContent=pageMeta[id][0];pageSubtitle.textContent=pageMeta[id][1];
 if(id==='clientes')renderClients();if(id==='cursos')renderCourses();if(id==='pagamentos')renderPayments();if(id==='dashboard')renderDashboard();if(id==='usuarios')renderUsers();
