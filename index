     <div class="course-field">
       <label>Dia do vencimento</label>
       <input class="c-due-day" type="number" min="1" max="31" placeholder="Ex.: 10" value="${esc(data.dueDay||'')}">
     </div>
     <div class="course-field">
       <label>Observações</label>
       <input class="c-notes" placeholder="Observações financeiras ou do curso" value="${esc(data.notes||'')}">
     </div>
   </div>`;
 courseRows.appendChild(div);
 recalcInstallment(div);
}
function syncCourseDefaults(select){
 const row=select.closest('.course-entry');
 const cat=courseCatalog.find(x=>x.name===select.value);
 if(!cat)return;
 if(cat.defaultHours && !row.querySelector('.c-hours').value)row.querySelector('.c-hours').value=cat.defaultHours;
 if(Number(cat.price)>0 && !row.querySelector('.c-value').value)row.querySelector('.c-value').value=cat.price;
 recalcInstallment(row);
}
function saveClient(){
 const fullName=document.getElementById('studentNameField').value.trim();
 const cpfRaw=document.getElementById('cpf').value.trim();
 const cpfDigits=normalizeCPF(cpfRaw);
 const portalLogin=document.getElementById('portalLoginField').value.trim();
 const portalPassword=document.getElementById('portalPasswordField').value;

 if(!fullName){alert('Informe o nome completo do aluno.');return}
 if(cpfDigits.length!==11){alert('Informe um CPF com 11 números.');return}
 if(!portalLogin){alert('Informe o login do Portal do Aluno.');return}
 if(!portalPassword){alert('Informe a senha do Portal do Aluno.');return}

 const currentId=document.getElementById('editId').value;
 const duplicateCPF=clients.find(x=>normalizeCPF(x.cpf)===cpfDigits && x.id!==currentId);
 if(duplicateCPF){alert('Já existe um aluno cadastrado com este CPF.');return}

 const duplicateLogin=clients.find(x=>loginKey(x.portalLogin)===loginKey(portalLogin) && x.id!==currentId);
 if(duplicateLogin){alert('Este login do Portal já está sendo utilizado por outro aluno.');return}

 const courses=[...document.querySelectorAll('.course-entry')].map(r=>({
  name:r.querySelector('.c-name').value.trim(),
  schedule:r.querySelector('.c-schedule')?.value||'',
  hours:Number(r.querySelector('.c-hours').value)||0,
  value:Number(r.querySelector('.c-value')?.value)||0,
  paymentMethod:r.querySelector('.c-payment-method')?.value||'',
  paymentType:r.querySelector('.c-payment-type')?.value||'',
  installments:Math.max(1,Number(r.querySelector('.c-installments')?.value)||1),
  installmentValue:Number(r.querySelector('.c-installment-value')?.value)||0,
  dueDay:Math.min(31,Math.max(1,Number(r.querySelector('.c-due-day')?.value)||1)),
  paymentStatus:'Em andamento',
  installmentStatuses:[],
  notes:r.querySelector('.c-notes').value.trim()
 })).filter(x=>x.name);

 const previousClient=clients.find(x=>x.id===currentId);
 courses.forEach((course,idx)=>{
   const prev=previousClient?.courses?.[idx];
   const count=Math.max(1,Number(course.installments)||1);
   if(prev&&prev.name===course.name&&Array.isArray(prev.installmentStatuses)){
     course.installmentStatuses=prev.installmentStatuses.map(st=>st==='Pago'?'Pago':'').slice(0,count);
     while(course.installmentStatuses.length<count)course.installmentStatuses.push('');
   }else course.installmentStatuses=Array(count).fill('');
   course.paymentStatus=course.installmentStatuses.every(st=>st==='Pago')?'Pago':'Em andamento';
 });

 const id=currentId||('a'+Date.now());
 const idx=clients.findIndex(x=>x.id===id);
 const obj={
  id,
  name:fullName,
  cpf:cpfRaw,
  phone:document.getElementById('phone').value.trim(),
  email:document.getElementById('email').value.trim(),
  status:document.getElementById('clientStatus').value,
  createdAt:document.getElementById('createdAt').value,
  notes:document.getElementById('notes').value.trim(),
  courses,
  portalLogin,
  portalPassword
 };

 if(idx>=0)clients[idx]=obj;else clients.push(obj);

 try{
   persistStudents();
   const check=JSON.parse(localStorage.getItem(STUDENT_KEY)||'[]');
   const saved=Array.isArray(check)&&check.some(x=>x.id===id&&x.portalLogin===portalLogin&&x.portalPassword===portalPassword);
   if(!saved)throw new Error('Falha ao confirmar gravação local');
 }catch(err){
   alert('Não foi possível salvar os dados neste navegador. Verifique se o armazenamento local está permitido.');
   return;
 }

 closeModal();
 renderAll();
 showPage('clientes');
 showCredentials(obj.id);
 toastMsg('Aluno salvo com login e senha do Portal.');
}
function editClient(id){
 const c=clients.find(x=>x.id===id);if(!c)return;
 modalTitle.textContent='Editar aluno';
 document.getElementById('editId').value=c.id;
 document.getElementById('studentNameField').value=c.name||'';
 document.getElementById('cpf').value=c.cpf||'';
 document.getElementById('phone').value=c.phone||'';
 document.getElementById('email').value=c.email||'';
 document.getElementById('clientStatus').value=c.status||'Ativo';
 document.getElementById('createdAt').value=c.createdAt||'';
 document.getElementById('notes').value=c.notes||'';
 document.getElementById('portalLoginField').value=c.portalLogin||normalizeCPF(c.cpf||'');
 document.getElementById('portalPasswordField').value=c.portalPassword||generatedPassword(c.name||'');
 courseRows.innerHTML='';
 (c.courses||[]).forEach(addCourseRow);
 if(!(c.courses||[]).length)addCourseRow();
 clientModal.classList.add('open');
}
function deleteClient(id){if(confirm('Excluir este aluno, seus cursos e o acesso ao Portal do Aluno?')){clients=clients.filter(x=>x.id!==id);persistStudents();renderAll()}}
function showCredentials(id){
 const c=clients.find(x=>x.id===id);if(!c)return;lastCredential=c;credentialName.textContent=c.name;credentialLogin.textContent=c.portalLogin||'CPF não cadastrado';credentialPassword.textContent=c.portalPassword||'—';credentialModal.classList.add('open');
}
function copyCredentials(){
 if(!lastCredential)return;
 const text=`Portal do Aluno - Única Terapias\nAluno: ${lastCredential.name}\nLogin: ${lastCredential.portalLogin}\nSenha: ${lastCredential.portalPassword}`;
 if(navigator.clipboard){navigator.clipboard.writeText(text).then(()=>toastMsg('Credenciais copiadas.'))}
 else{prompt('Copie as credenciais:',text)}
}
function renderStudentPortal(c){
 c=ensureCredentials(c);const cs=c.courses||[],hours=cs.reduce((sum,x)=>sum+(Number(x.hours)||0),0);
 const allInstallments=cs.flatMap(x=>buildInstallmentsForCourse(c,x));
 const hasOverdue=allInstallments.some(p=>p.status==='Vencido');
 const allPaid=allInstallments.length>0&&allInstallments.every(p=>p.status==='Pago');
 const financialStatus=hasOverdue?'Vencido':(allPaid?'Pago':'Em dia');
 studentWelcome.textContent='Olá, '+(c.name.split(/\s+/)[0]||c.name)+'!';
 studentStatusBadge.innerHTML=badge(c.status||'Ativo');studentCourseCount.textContent=cs.length;studentHours.textContent=hours+'h';studentPending.textContent=financialStatus;
 studentInfo.innerHTML=`
 <div class="info-line"><small>Nome completo</small><strong>${esc(c.name)}</strong></div>
 <div class="info-line"><small>CPF</small><strong>${esc(c.cpf||'—')}</strong></div>
 <div class="info-line"><small>Telefone</small><strong>${esc(c.phone||'—')}</strong></div>
 <div class="info-line"><small>E-mail</small><strong>${esc(c.email||'—')}</strong></div>
 <div class="info-line"><small>Data de cadastro</small><strong>${fmtDate(c.createdAt)}</strong></div>`;
 studentCourses.innerHTML=cs.length?cs.map(x=>{
   const inst=buildInstallmentsForCourse(c,x);
   const status=courseDisplayStatus(c,x);
   const next=inst.find(p=>p.status!=='Pago');
   const paidCount=inst.filter(p=>p.status==='Pago').length;
   return `<div class="course-card"><div class="course-card-head"><div><h4>${esc(x.name)}</h4><small style="color:var(--muted)">${esc(x.notes||'')}</small></div>${badge(status)}</div><div class="course-meta">
 <div><small>CARGA HORÁRIA</small><b>${Number(x.hours)||0} horas</b></div>
 <div><small>HORÁRIO</small><b>${esc(x.schedule||'—')}${x.schedule?` • ${esc(getScheduleTime(x.schedule))}`:''}</b></div>
 <div><small>VALOR DO CURSO</small><b>${brl(x.value||0)}</b></div>
 <div><small>FORMA DE PAGAMENTO</small><b>${esc(x.paymentMethod||'—')}</b></div>
 <div><small>TIPO DE PAGAMENTO</small><b>${esc(x.paymentType||'—')}</b></div>
 <div><small>PARCELAMENTO</small><b>${Number(x.installments)||1}x${Number(x.installments)>1?` de ${brl(x.installmentValue||((Number(x.value)||0)/(Number(x.installments)||1)))}`:''}</b></div>
 <div><small>PARCELAS PAGAS</small><b>${paidCount} de ${inst.length}</b></div>
 <div><small>PRÓXIMO VENCIMENTO</small><b>${next?fmtDate(next.dueDate):'Curso quitado'}</b></div>
 </div></div>`;
 }).join(''):`<div class="empty">Nenhum curso vinculado ao seu cadastro.</div>`;
}
function toCSV(rows){return rows.map(r=>r.map(v=>`"${String(v??'').replace(/"/g,'""')}"`).join(';')).join('\n')}
function download(text,name,type='text/csv;charset=utf-8;'){const b=new Blob(['\ufeff'+text],{type});const a=document.createElement('a');a.href=URL.createObjectURL(b);a.download=name;a.click();setTimeout(()=>URL.revokeObjectURL(a.href),500)}
function exportClientsCSV(){const rows=[['Aluno','CPF','Telefone','Email','Status','Cursos','Carga Horária Total','Login Portal','Senha Portal']];clients.forEach(c=>rows.push([c.name,c.cpf,c.phone,c.email,c.status,(c.courses||[]).map(x=>x.name).join(' | '),(c.courses||[]).reduce((s,x)=>s+(Number(x.hours)||0),0),c.portalLogin,c.portalPassword]));download(toCSV(rows),'unica_alunos.csv')}
function exportCoursesCSV(){const rows=[['Aluno','Curso','Horário','Faixa de Horário','Carga Horária','Valor Curso','Forma Pagamento','Tipo Pagamento','Parcelas','Valor Parcela','Dia Vencimento','Status Pagamento','Observações']];clients.forEach(c=>(c.courses||[]).forEach(x=>rows.push([c.name,x.name,x.schedule||'',getScheduleTime(x.schedule||''),x.hours,x.value||0,x.paymentMethod||'',x.paymentType||'',x.installments||1,x.installmentValue||0,x.dueDay||1,courseDisplayStatus(c,x),x.notes])));download(toCSV(rows),'unica_cursos.csv')}
function exportPaymentsCSV(){
 const rows=[['Aluno','Curso','Parcela','Total Parcelas','Valor Parcela','Vencimento','Forma Pagamento','Tipo Pagamento','Status']];
 clients.forEach(c=>(c.courses||[]).forEach(x=>buildInstallmentsForCourse(c,x).forEach(p=>rows.push([c.name,x.name,p.installment,p.totalInstallments,p.value,fmtDate(p.dueDate),x.paymentMethod||'',x.paymentType||'',p.status]))));
 download(toCSV(rows),'unica_pagamentos_mensais.csv')
}
function exportCSV(){exportClientsCSV()}
function backupJSON(){download(JSON.stringify({version:9,exportedAt:new Date().toISOString(),admin,clients},null,2),'unica_backup_v9.json','application/json')}
function importJSON(ev){
 const f=ev.target.files[0];if(!f)return;const r=new FileReader();r.onload=()=>{try{const d=JSON.parse(r.result);clients=(Array.isArray(d)?d:(d.clients||[])).map(ensureCredentials);if(d.admin){admin=d.admin;persistAdmin()}persistStudents();renderAll();toastMsg('Backup importado com sucesso.')}catch(e){alert('Arquivo inválido.')}};r.readAsText(f);
}
function clearStudentData(){if(confirm('Tem certeza que deseja apagar todos os alunos, cursos e portais de alunos?')){clients=[];persistStudents();renderAll();toastMsg('Cadastros de alunos apagados.')}}
function renderAll(){renderDashboard();renderClients();renderCourses();renderPayments();renderUsers();renderCourseCatalog();renderScheduleCatalog()}
function toastMsg(msg){toast.textContent=msg;toast.classList.add('show');setTimeout(()=>toast.classList.remove('show'),3000)}

init();
</script>
</body>
</html>
