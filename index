 const sel=document.getElementById('financeYear');if(!sel)return;
 const years=new Set([new Date().getFullYear()]);
 clients.forEach(c=>(c.courses||[]).forEach(x=>buildInstallmentsForCourse(c,x).forEach(p=>years.add(p.year))));
 const current=Number(sel.value)||new Date().getFullYear();
 sel.innerHTML=[...years].sort((a,b)=>a-b).map(y=>`<option value="${y}" ${y===current?'selected':''}>${y}</option>`).join('');
}
function setInstallmentStatus(clientId,courseIndex,installmentIndex,status){
 const c=clients.find(x=>x.id===clientId);if(!c)return;
 const course=c.courses?.[courseIndex];if(!course)return;
 const count=Math.max(1,Number(course.installments)||1);
 if(!Array.isArray(course.installmentStatuses))course.installmentStatuses=Array(count).fill('');
 while(course.installmentStatuses.length<count)course.installmentStatuses.push('');
 course.installmentStatuses[installmentIndex]=status==='Pago'?'Pago':'';
 course.installmentStatuses=course.installmentStatuses.slice(0,count);
 course.paymentStatus=course.installmentStatuses.every(x=>x==='Pago')?'Pago':'Em andamento';
 persistStudents();renderPayments();renderDashboard();renderClients();renderCourses();
}
