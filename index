<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Única Gestão | Sistema Administrativo e Portal do Aluno</title>
<style>
:root{
  --bg:#f4f7f6;--panel:#fff;--text:#17332c;--muted:#6c7d78;--line:#dfe7e4;
  --primary:#1d6b58;--primary2:#2b8c72;--dark:#103b31;--soft:#eaf4f0;
  --danger:#b83f4f;--warn:#ae7418;--ok:#18734d;--shadow:0 14px 34px rgba(18,58,48,.09)
}
*{box-sizing:border-box}body{margin:0;font-family:Inter,ui-sans-serif,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;background:var(--bg);color:var(--text)}
button,input,select,textarea{font:inherit}button{cursor:pointer}.hidden{display:none!important}

/* LOGIN */
.auth-screen{min-height:100vh;display:grid;grid-template-columns:1.05fr .95fr;background:linear-gradient(135deg,#0e3c31,#1b6956)}
.auth-visual{padding:64px;display:flex;flex-direction:column;justify-content:space-between;color:#fff;position:relative;overflow:hidden}
.auth-visual:before,.auth-visual:after{content:"";position:absolute;border-radius:50%;background:rgba(255,255,255,.06)}
.auth-visual:before{width:420px;height:420px;right:-170px;top:-80px}.auth-visual:after{width:300px;height:300px;left:-120px;bottom:-80px}
.auth-brand{display:flex;align-items:center;gap:14px;position:relative;z-index:1}.auth-logo{width:58px;height:58px;border-radius:18px;background:#fff;color:var(--primary);display:grid;place-items:center;font-size:26px;font-weight:900}
.auth-brand h1{margin:0;font-size:24px}.auth-brand small{opacity:.72}.auth-message{position:relative;z-index:1;max-width:560px}.auth-message h2{font-size:45px;line-height:1.08;margin:0 0 18px}.auth-message p{font-size:17px;line-height:1.7;color:#dbece6}
.auth-copy{position:relative;z-index:1;font-size:12px;opacity:.66}
.auth-panel{background:#f7faf9;display:flex;align-items:center;justify-content:center;padding:30px}
.login-card{width:min(480px,100%);background:#fff;border:1px solid var(--line);border-radius:24px;padding:30px;box-shadow:0 25px 70px rgba(6,34,27,.18)}
.login-card h2{margin:0 0 6px}.login-card>p{margin:0 0 24px;color:var(--muted);font-size:14px}
.auth-tabs{display:grid;grid-template-columns:1fr 1fr;background:#eef4f2;padding:5px;border-radius:13px;margin-bottom:22px}.auth-tabs button{border:0;background:transparent;padding:11px;border-radius:10px;font-weight:800;color:#698079}.auth-tabs button.active{background:#fff;color:var(--primary);box-shadow:0 4px 12px rgba(16,59,49,.08)}
.field{display:flex;flex-direction:column;gap:7px}.field label{font-size:12px;font-weight:800;color:#536c65}.field input,.field select,.field textarea{border:1px solid var(--line);border-radius:11px;padding:11px 12px;background:#fff;outline:none}.field input:focus,.field select:focus,.field textarea:focus{border-color:#84b8a8;box-shadow:0 0 0 3px rgba(29,107,88,.08)}
.auth-form{display:grid;gap:14px}.login-help{font-size:12px;color:var(--muted);line-height:1.5;padding:11px 12px;background:#f4f8f6;border-radius:10px;border:1px solid #e0ebe7}
.error{font-size:12px;color:var(--danger);font-weight:700;min-height:18px}
.btn{border:1px solid var(--line);background:#fff;color:var(--text);border-radius:11px;padding:10px 14px;font-weight:800}.btn:hover{background:#f8fbfa}.btn.primary{background:var(--primary);border-color:var(--primary);color:#fff}.btn.primary:hover{background:#185b4b}.btn.full{width:100%;padding:12px}
.setup-title{display:flex;gap:12px;align-items:center;margin-bottom:18px}.setup-icon{width:44px;height:44px;border-radius:13px;background:var(--soft);display:grid;place-items:center;font-size:20px}

/* ADMIN APP */
.app{display:grid;grid-template-columns:260px 1fr;min-height:100vh}.sidebar{background:linear-gradient(180deg,#154c40,#10392f);color:#fff;padding:24px 18px;position:sticky;top:0;height:100vh}
.brand{display:flex;align-items:center;gap:12px;padding:4px 8px 24px;border-bottom:1px solid rgba(255,255,255,.14)}.logo{width:48px;height:48px;border-radius:16px;background:linear-gradient(135deg,#fff,#d7efe7);color:#174f42;display:grid;place-items:center;font-weight:900;font-size:22px}.brand h1{font-size:18px;margin:0}.brand small{display:block;opacity:.72;margin-top:3px}
.nav{display:flex;flex-direction:column;gap:8px;margin-top:22px}.nav button{border:0;background:transparent;color:#eaf5f1;text-align:left;padding:12px 14px;border-radius:12px;display:flex;gap:10px;align-items:center}.nav button:hover,.nav button.active{background:rgba(255,255,255,.12);color:#fff}
.sidebar-footer{position:absolute;left:18px;right:18px;bottom:18px;padding:14px;border-radius:14px;background:rgba(255,255,255,.08);font-size:12px;line-height:1.5}
.main{min-width:0}.topbar{height:76px;background:rgba(255,255,255,.93);backdrop-filter:blur(10px);border-bottom:1px solid var(--line);display:flex;align-items:center;justify-content:space-between;padding:0 28px;position:sticky;top:0;z-index:5}.topbar h2{margin:0;font-size:21px}.topbar p{margin:4px 0 0;color:var(--muted);font-size:13px}.top-actions{display:flex;gap:10px;align-items:center}.content{padding:26px}.page{display:none}.page.active{display:block}
.cards{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:16px;margin-bottom:20px}.card{background:var(--panel);border:1px solid var(--line);border-radius:18px;padding:19px;box-shadow:var(--shadow)}.stat .label{font-size:13px;color:var(--muted);font-weight:800}.stat .value{font-size:28px;font-weight:900;margin:8px 0 4px}.stat .hint{font-size:12px;color:var(--muted)}
.grid-2{display:grid;grid-template-columns:1.15fr .85fr;gap:18px}.section-title{display:flex;justify-content:space-between;gap:12px;align-items:center;margin-bottom:16px}.section-title h3{margin:0;font-size:17px}.section-title small{color:var(--muted)}
.toolbar{display:flex;gap:10px;flex-wrap:wrap;margin-bottom:16px}.toolbar input,.toolbar select{background:#fff;border:1px solid var(--line);border-radius:11px;padding:10px 12px;min-width:180px}.table-wrap{overflow:auto;border:1px solid var(--line);border-radius:14px}table{border-collapse:collapse;width:100%;min-width:850px;background:#fff}th,td{text-align:left;padding:13px 14px;border-bottom:1px solid var(--line);font-size:13px;vertical-align:middle}th{background:#f6faf8;color:#557068;font-size:12px;text-transform:uppercase;letter-spacing:.04em}tr:hover td{background:#fbfdfc}
.badge{display:inline-flex;align-items:center;border-radius:999px;padding:6px 10px;font-size:11px;font-weight:800;white-space:nowrap}.paid{background:#e6f5ee;color:var(--ok)}.pending{background:#fff4da;color:var(--warn)}.overdue{background:#fde9ec;color:var(--danger)}.active-b{background:#e8f3ef;color:var(--primary)}.inactive-b{background:#edf0ef;color:#687873}.actions{display:flex;gap:6px}.icon-btn{border:1px solid var(--line);background:#fff;border-radius:9px;padding:7px 9px}.icon-btn:hover{background:#f5f8f7}.empty{text-align:center;color:var(--muted);padding:34px!important}
.mini-list{display:flex;flex-direction:column;gap:10px}.mini-row{display:flex;justify-content:space-between;gap:10px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}.mini-row:last-child{border-bottom:0}.mini-row b{display:block;font-size:13px}.mini-row small{color:var(--muted)}
.notice{border:1px solid #d9e8e2;background:#f1f8f5;border-radius:13px;padding:12px 14px;font-size:12px;color:#4f6b62;margin-bottom:16px}.report-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:15px}.report-card{background:#fff;border:1px solid var(--line);border-radius:16px;padding:18px}.report-card h4{margin:0 0 8px}.report-card p{margin:0 0 14px;color:var(--muted);font-size:13px;line-height:1.45}
.portal-access{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:14px;border-radius:13px;background:#f2f8f5;border:1px solid #dcebe5;margin-top:5px}.portal-access small{display:block;color:var(--muted);font-size:11px}.portal-access strong{display:block;margin-top:3px;font-size:13px;word-break:break-all}
.mobile-menu{display:none}

/* MODAL */
.modal{position:fixed;inset:0;background:rgba(10,30,25,.44);display:none;align-items:center;justify-content:center;padding:18px;z-index:20}.modal.open{display:flex}.modal-card{width:min(820px,100%);max-height:92vh;overflow:auto;background:#fff;border-radius:20px;box-shadow:0 25px 80px rgba(0,0,0,.25)}.modal-head{display:flex;justify-content:space-between;align-items:center;padding:20px 22px;border-bottom:1px solid var(--line)}.modal-head h3{margin:0}.modal-body{padding:22px}.form-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.field.full{grid-column:1/-1}.field textarea{min-height:84px;resize:vertical}.modal-foot{padding:18px 22px;border-top:1px solid var(--line);display:flex;justify-content:flex-end;gap:10px}.course-box{margin-top:18px;padding-top:18px;border-top:1px solid var(--line)}
.course-entry{border:1px solid var(--line);border-radius:16px;padding:15px;margin-bottom:14px;background:#fbfdfc}
.course-row{display:grid;gap:10px;margin-bottom:10px;align-items:end}
.course-row:last-child{margin-bottom:0}
.course-row.academic{grid-template-columns:1.35fr 1fr .7fr auto}
.course-row.finance{grid-template-columns:.8fr 1fr 1.2fr .6fr .8fr}
.course-row.status{grid-template-columns:.8fr .8fr 1.4fr}
.course-field{display:flex;flex-direction:column;gap:5px;min-width:0}
.course-field label{font-size:11px;font-weight:800;color:#61756e;text-transform:uppercase;letter-spacing:.03em}
.course-field input,.course-field select{width:100%;min-width:0;border:1px solid var(--line);border-radius:10px;padding:10px;background:#fff}
.course-remove{align-self:end;height:42px}


/* STUDENT PORTAL */
.student-shell{min-height:100vh;background:#f4f7f6}.student-head{background:linear-gradient(135deg,#123f35,#1f725e);color:#fff;padding:26px 30px}.student-head-inner{max-width:1100px;margin:auto;display:flex;justify-content:space-between;gap:20px;align-items:center}.student-brand{display:flex;gap:12px;align-items:center}.student-brand .logo{width:45px;height:45px}.student-head h2{margin:0;font-size:19px}.student-head p{margin:4px 0 0;color:#d5e9e2;font-size:12px}.student-content{max-width:1100px;margin:0 auto;padding:26px}.welcome-card{background:#fff;border:1px solid var(--line);border-radius:20px;padding:24px;box-shadow:var(--shadow);display:flex;justify-content:space-between;gap:16px;align-items:center;margin-bottom:18px}.welcome-card h1{font-size:25px;margin:0 0 6px}.welcome-card p{margin:0;color:var(--muted)}.student-grid{display:grid;grid-template-columns:.75fr 1.25fr;gap:18px}.student-info{display:grid;gap:11px}.info-line{padding-bottom:11px;border-bottom:1px solid var(--line)}.info-line:last-child{border-bottom:0}.info-line small{display:block;color:var(--muted);font-size:11px;text-transform:uppercase;font-weight:800}.info-line strong{display:block;margin-top:3px;font-size:14px}.course-card{border:1px solid var(--line);border-radius:15px;padding:16px;margin-bottom:12px}.course-card:last-child{margin-bottom:0}.course-card-head{display:flex;justify-content:space-between;gap:10px;align-items:flex-start}.course-card h4{margin:0 0 5px}.course-meta{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:14px}.course-meta div{background:#f7faf9;border-radius:10px;padding:10px}.course-meta small{display:block;color:var(--muted);font-size:11px}.course-meta b{font-size:13px}.student-summary{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin-bottom:18px}


.month-toolbar{display:flex;gap:10px;align-items:center;flex-wrap:wrap;margin-bottom:18px}
.month-toolbar select,.month-toolbar input{border:1px solid var(--line);border-radius:11px;padding:10px 12px;background:#fff}
.month-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:16px}
.month-niche{background:#fff;border:1px solid var(--line);border-radius:18px;overflow:hidden;box-shadow:var(--shadow)}
.month-niche-head{display:flex;justify-content:space-between;gap:12px;align-items:center;padding:16px 18px;background:#f4f8f6;border-bottom:1px solid var(--line)}
.month-niche-head h3{margin:0;font-size:16px}.month-niche-head small{color:var(--muted)}
.month-total{font-weight:900;color:var(--primary)}
.month-items{padding:0 16px}
.month-item{display:grid;grid-template-columns:1.2fr 1fr .65fr .75fr .8fr auto;gap:10px;align-items:center;padding:13px 0;border-bottom:1px solid var(--line);font-size:12px}
.month-item:last-child{border-bottom:0}
.month-item b{display:block;font-size:13px}.month-item small{color:var(--muted)}
.month-empty{padding:20px;color:var(--muted);text-align:center;font-size:12px}
@media(max-width:900px){.month-grid{grid-template-columns:1fr}.month-item{grid-template-columns:1fr 1fr 1fr}}
@media(max-width:560px){.month-item{grid-template-columns:1fr}}

/* TOAST */
.toast{position:fixed;right:20px;bottom:20px;background:#173d34;color:#fff;border-radius:12px;padding:13px 16px;box-shadow:0 14px 35px rgba(0,0,0,.2);z-index:50;display:none;max-width:380px}.toast.show{display:block}

@media(max-width:820px){
 .course-row.academic{grid-template-columns:1fr 1fr}
 .course-row.finance{grid-template-columns:1fr 1fr}
 .course-row.status{grid-template-columns:1fr}
}
@media(max-width:1000px){
 .auth-screen{grid-template-columns:1fr}.auth-visual{display:none}.app{grid-template-columns:1fr}.sidebar{display:none}.cards{grid-template-columns:repeat(2,1fr)}.grid-2,.student-grid{grid-template-columns:1fr}.mobile-menu{display:inline-flex}.topbar{padding:0 18px}.content{padding:18px}.report-grid{grid-template-columns:1fr}
}
@media(max-width:640px){
 .auth-panel{padding:16px}.login-card{padding:22px}.cards,.student-summary{grid-template-columns:1fr}.form-grid{grid-template-columns:1fr}.field.full{grid-column:auto}.portal-access{grid-template-columns:1fr}.topbar{height:auto;padding:12px 14px;align-items:flex-start}.top-actions{flex-wrap:wrap;justify-content:flex-end}.content,.student-content{padding:14px}.student-head{padding:18px 14px}.student-head-inner,.welcome-card{align-items:flex-start;flex-direction:column}.course-meta{grid-template-columns:1fr}
 .course-row.academic,.course-row.finance,.course-row.status{grid-template-columns:1fr}
 .course-remove{width:100%;height:42px}
}
</style>
</head>
<body>

<!-- LOGIN / SETUP -->
<section id="authScreen" class="auth-screen">
  <div class="auth-visual">
    <div class="auth-brand"><div class="auth-logo">U</div><div><h1>Única Gestão</h1><small>Sistema Administrativo + Portal do Aluno</small></div></div>
    <div class="auth-message">
      <h2>Gestão completa e acesso individual para cada aluno.</h2>
      <p>O administrador controla cadastros, cursos, carga horária e pagamentos. Cada aluno acessa somente o próprio portal usando CPF e a senha criada automaticamente pelo sistema.</p>
    </div>
    <div class="auth-copy">Ambiente administrativo independente do site principal.</div>
  </div>
  <div class="auth-panel">
    <div class="login-card">
      <div id="firstSetup" class="hidden">
        <div class="setup-title"><div class="setup-icon">🔐</div><div><h2 style="margin:0">Criar acesso administrativo</h2><p style="margin:4px 0 0;color:var(--muted);font-size:13px">Primeiro acesso ao sistema</p></div></div>
        <div class="auth-form">
          <div class="field"><label>Nome do administrador</label><input id="setupName" placeholder="Nome completo"></div>
          <div class="field"><label>E-mail</label><input id="setupEmail" type="email" placeholder="email@empresa.com"></div>
          <div class="field"><label>Usuário de acesso</label><input id="setupUser" placeholder="Ex.: admin"></div>
          <div class="field"><label>Senha</label><input id="setupPass" type="password" placeholder="Crie uma senha"></div>
          <div id="setupError" class="error"></div>
          <button class="btn primary full" onclick="createAdmin()">Criar administrador e entrar</button>
        </div>
      </div>

      <div id="loginArea">
        <h2>Entrar no sistema</h2>
        <p>Selecione o tipo de acesso para continuar.</p>
        <div class="auth-tabs">
          <button id="tabAdmin" class="active" onclick="setLoginMode('admin')">Administração</button>
          <button id="tabStudent" onclick="setLoginMode('student')">Portal do Aluno</button>
        </div>

        <div id="adminLogin" class="auth-form">
          <div class="field"><label>Usuário</label><input id="adminUser" value="admin" autocomplete="username"></div>
          <div class="field"><label>Senha</label><input id="adminPass" type="password" value="admin" autocomplete="current-password"></div>
          <div class="login-help">Acesso administrativo temporário: <b>usuário admin</b> e <b>senha admin</b>. Após entrar, altere as credenciais em <b>Usuários</b>.</div>
          <div id="adminLoginError" class="error"></div>
          <button class="btn primary full" onclick="loginAdmin()">Entrar na administração</button>
        </div>

        <div id="studentLogin" class="auth-form hidden">
          <div class="field"><label>Login</label><input id="studentCPF" placeholder="CPF ou login personalizado" autocomplete="username"></div>
          <div class="field"><label>Senha</label><input id="studentPass" type="password" autocomplete="current-password"></div>
          <div class="login-help">No primeiro cadastro, o login padrão é o <b>CPF</b> e a senha é <b>último sobrenome + primeiro nome</b>. O administrador pode alterar os dois depois.</div>
          <div id="studentLoginError" class="error"></div>
          <button class="btn primary full" onclick="loginStudent()">Entrar no meu portal</button>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- ADMIN -->
<div id="adminApp" class="app hidden">
  <aside class="sidebar">
    <div class="brand"><div class="logo">U</div><div><h1>Única Gestão</h1><small>Administração</small></div></div>
    <div class="nav">
      <button class="active" data-page="dashboard">▦ Dashboard</button>
      <button data-page="clientes">👤 Alunos</button>
      <button data-page="cursos">🎓 Cursos</button>
      <button data-page="pagamentos">💳 Pagamentos</button>
      <button data-page="relatorios">📊 Relatórios</button>
      <button data-page="usuarios">🔐 Usuários</button>
      <button data-page="dados">⚙️ Dados & Backup</button>
    </div>
    <div class="sidebar-footer"><b id="adminSidebarName">Administrador</b><br><span style="opacity:.72">Acesso completo ao sistema</span></div>
  </aside>
  <main class="main">
    <header class="topbar">
      <div><h2 id="pageTitle">Dashboard</h2><p id="pageSubtitle">Visão geral do controle de alunos, cursos e pagamentos</p></div>
      <div class="top-actions">
        <button class="btn mobile-menu" onclick="cyclePage()">☰ Menu</button>
        <button class="btn" onclick="exportCSV()">Exportar CSV</button>
        <button class="btn primary" onclick="openClientModal()">+ Novo aluno</button>
        <button class="btn" onclick="logout()">Sair</button>
      </div>
    </header>

    <section class="content">
      <div id="dashboard" class="page active">
        <div class="cards">
          <div class="card stat"><div class="label">ALUNOS CADASTRADOS</div><div class="value" id="kpiClients">0</div><div class="hint">Cada aluno possui portal individual</div></div>
          <div class="card stat"><div class="label">CURSOS EM EXECUÇÃO</div><div class="value" id="kpiEnrollments">0</div><div class="hint">Cursos vinculados aos alunos</div></div>
          <div class="card stat"><div class="label">CARGA HORÁRIA TOTAL</div><div class="value" id="kpiHours">0h</div><div class="hint">Somatório das cargas cadastradas</div></div>
          <div class="card stat"><div class="label">PAGAMENTOS PENDENTES</div><div class="value" id="kpiPending">0</div><div class="hint">Pendentes ou vencidos</div></div>
        </div>
        <div class="grid-2">
          <div class="card">
            <div class="section-title"><div><h3>Últimos alunos</h3><small>Cadastros mais recentes</small></div><button class="btn" onclick="showPage('clientes')">Ver todos</button></div>
            <div class="table-wrap"><table><thead><tr><th>Aluno</th><th>Curso(s)</th><th>Pagamento</th><th>Status</th></tr></thead><tbody id="dashClients"></tbody></table></div>
          </div>
          <div class="card">
            <div class="section-title"><div><h3>Situação financeira</h3><small>Resumo dos cursos vinculados</small></div></div>
            <div class="mini-list" id="financeSummary"></div>
          </div>
        </div>
      </div>

      <div id="clientes" class="page">
        <div class="card">
          <div class="section-title"><div><h3>Cadastro de alunos</h3><small>Cada cadastro cria automaticamente um Portal do Aluno</small></div><button class="btn primary" onclick="openClientModal()">+ Cadastrar aluno</button></div>
          <div class="toolbar">
            <input id="clientSearch" placeholder="Buscar por nome, CPF, telefone..." oninput="renderClients()">
            <select id="clientStatusFilter" onchange="renderClients()"><option value="">Todos os status</option><option>Ativo</option><option>Inativo</option></select>
            <select id="paymentFilter" onchange="renderClients()"><option value="">Todos pagamentos</option><option>Em dia</option><option>Pago</option><option>Vencido</option></select>
          </div>
          <div class="table-wrap"><table><thead><tr><th>Aluno</th><th>Contato</th><th>Cursos</th><th>Carga horária</th><th>Pagamento</th><th>Portal</th><th>Ações</th></tr></thead><tbody id="clientsTable"></tbody></table></div>
        </div>
      </div>

      <div id="cursos" class="page">
        <div class="grid-2" style="grid-template-columns:1fr 1fr;margin-bottom:18px">
          <div class="card">
            <div class="section-title">
              <div><h3>Grade de cursos</h3><small>Cursos disponíveis para cadastro de alunos</small></div>
              <button class="btn primary" onclick="openCourseCatalogModal()">+ Cadastrar novo curso</button>
            </div>
            <div id="courseCatalogList" class="mini-list"></div>
          </div>
          <div class="card">
            <div class="section-title">
              <div><h3>Horários disponíveis</h3><small>Opções padrão da escola</small></div>
              <button class="btn" onclick="openScheduleModal()">+ Novo horário</button>
            </div>
            <div id="scheduleCatalogList" class="mini-list"></div>
          </div>
        </div>
        <div class="card">
